# Copy to `.env.local` and adjust. Only VITE_-prefixed vars reach the browser
# bundle — never put secrets here.

# Base path every API request is prefixed with. Leave as `/api` so requests are
# same-origin in dev (via the Vite proxy below) and in prod (via your CDN/ingress).
VITE_API_URL=/api

# Dev-only: where the Vite dev server forwards `/api` requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Start Mock Service Worker in the browser so the app runs with no backend.
VITE_ENABLE_MOCKS=false

# Shown in the UI / attached to error reports.
VITE_APP_NAME=Koyi
